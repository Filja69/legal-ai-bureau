# LOCAL: your local backend. STAGING: your Render backend URL
# (https://<service>.onrender.com) — must also be listed in the backend's
# CORS_ALLOWED_ORIGINS or auth requests will be rejected by the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010

# Staging-only, both optional — omit entirely for local dev and real production.
# Small non-intrusive "TEST ENVIRONMENT" notice (see components/StagingBanner.tsx).
NEXT_PUBLIC_STAGING_BANNER=false
# "Report an issue" link in the header — any URL (issue tracker, mailto:, form).
# Omitted entirely (no dead link) when this is unset.
NEXT_PUBLIC_FEEDBACK_URL=
