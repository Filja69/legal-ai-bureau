# Legal AI Bureau — environment template. Copy to .env and fill in real values.
# NEVER commit a real .env file — secrets must never reach git (LEGAL-SECURITY.md §3).

APP_NAME=legal-ai-bureau
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database / cache ---
DATABASE_URL=postgresql+asyncpg://legal:legal@localhost:5437/legal_ai_bureau
REDIS_URL=redis://localhost:6391/0

# --- LLM providers (app/llm — LEGAL-ARCHITECTURE.md §4) ---
# LLM_PROVIDER=mock until real keys are supplied. Never defaults to a live provider.
# LLM_PROVIDER=anthropic|openai without the matching *_API_KEY fails startup
# loudly (LLMProviderError) rather than silently falling back to mock.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60.0

# --- Auth (Phase 7 — app/security — LEGAL-SECURITY.md §4) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
JWT_ISSUER=legal-ai-bureau
JWT_AUDIENCE=legal-ai-bureau-api
# AUTH_DEV_MODE=true allows requests with NO Authorization header to use a
# deterministic dev identity — ONLY takes effect when ENVIRONMENT!=production,
# regardless of this flag. Never set true in a production deployment's .env.
AUTH_DEV_MODE=false

# --- Storage (app/documents/storage — LEGAL-SECURITY.md §3) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=

# --- Legal data sources (app/sources — LEGAL-SOURCES.md) ---
LEGAL_SOURCE_OFFICIAL_LAW_BASE_URL=https://pravo.gov.ru
LEGAL_SOURCE_COURT_BASE_URL=https://kad.arbitr.ru
LEGAL_SOURCE_COMMERCIAL_DB_ENABLED=false

# --- RAG / embeddings (app/rag — LEGAL-RAG.md) ---
# EMBEDDING_DIMENSION is baked into the pgvector column type at migration time —
# changing it later requires a new migration + full reindex, not just a config edit.
# EMBEDDING_PROVIDER=openai requires OPENAI_API_KEY above — never falls back to mock
# silently if the key is missing (Phase 6 brief §1/§20), it fails startup instead.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=96
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=3
# Phase 6.5 cost/safety ceilings — fail closed if exceeded, not a billing system.
EMBEDDING_MAX_DOCUMENTS_PER_REINDEX=5000
EMBEDDING_MAX_REQUESTS_PER_MINUTE=500

# --- Jurisdiction defaults (LEGAL-PRD.md §3) ---
DEFAULT_JURISDICTION=RU
DEFAULT_LANGUAGE=ru
