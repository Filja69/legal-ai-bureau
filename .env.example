# Legal AI Bureau — environment template. Copy to .env and fill in real values.
# NEVER commit a real .env file — secrets must never reach git (LEGAL-SECURITY.md §3).
#
# LOCAL / STAGING / PRODUCTION — where behavior actually differs (see
# docs/STAGING-DEPLOYMENT-AUDIT.md §3): ENVIRONMENT=development is the ONLY
# value that permits the insecure default JWT_SECRET, the AUTH_DEV_MODE
# bypass, and console (non-JSON) logs. Anything else — "staging",
# "production", or a typo — gets the strict checks. Set ENVIRONMENT=staging
# for the staging deployment; do not reuse "development" there just because
# it isn't real production.

APP_NAME=legal-ai-bureau
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database / cache ---
# STAGING: Neon's dashboard gives you `?sslmode=require` — the app rewrites
# this to asyncpg's expected `ssl=require` automatically (app/db/session.py
# _normalize_database_url), so paste the Neon string as-is after changing
# the driver prefix to postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://legal:legal@localhost:5437/legal_ai_bureau
# REDIS_URL is declared but has zero actual usage anywhere in this codebase
# today (rate limiting is deliberately in-process — see
# app/security/rate_limit.py). Not required for staging; only fill this in
# once a real feature actually needs Redis.
REDIS_URL=redis://localhost:6391/0

# --- LLM providers (app/llm — LEGAL-ARCHITECTURE.md §4) ---
# LLM_PROVIDER=mock until real keys are supplied. Never defaults to a live provider.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth ---
# STAGING/PRODUCTION: must be a real random value — the app refuses to boot
# with the insecure development default outside ENVIRONMENT=development.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
# STAGING/PRODUCTION: must be false (or unset). The dev/no-token bypass only
# ever applies when ENVIRONMENT=development, regardless of this value, but
# leave it false outside local dev anyway — belt and suspenders.
AUTH_DEV_MODE=false

# --- Storage (app/documents/storage — LEGAL-SECURITY.md §3, staging audit §5) ---
# LOCAL: STORAGE_PROVIDER=local writes to backend/var/documents/ on disk.
# STAGING: STORAGE_PROVIDER=s3 — Render's filesystem is ephemeral, uploaded
# documents would be lost on every redeploy/restart otherwise.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
# S3-compatible endpoint config — only read when STORAGE_PROVIDER=s3. Works
# with AWS S3, Cloudflare R2, Backblaze B2, MinIO, or any S3-compatible API.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Legal data sources (app/sources — LEGAL-SOURCES.md) ---
LEGAL_SOURCE_OFFICIAL_LAW_BASE_URL=https://pravo.gov.ru
LEGAL_SOURCE_COURT_BASE_URL=https://kad.arbitr.ru
LEGAL_SOURCE_COMMERCIAL_DB_ENABLED=false

# --- RAG / embeddings (app/rag — LEGAL-RAG.md) ---
# EMBEDDING_DIMENSION is baked into the pgvector column type at migration time —
# changing it later requires a new migration + full reindex, not just a config edit.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
EMBEDDING_DIMENSION=1536

# --- Jurisdiction defaults (LEGAL-PRD.md §3) ---
DEFAULT_JURISDICTION=RU
DEFAULT_LANGUAGE=ru

# --- Security (Phase 9 audit §15, staging audit §2) ---
# Comma-separated list of allowed browser origins for CORS — the frontend's
# real origin(s). A JSON array string (the old-only format) still works too.
# STAGING: include your Vercel deployment URL; keep localhost for local dev
# convenience only if this .env is not staging's actual runtime config.
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=26214400
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LLM_PER_MINUTE=20
